# 核心机密数据（千万不能上传到公共仓库）
accounts/*.json
accounts/agent-backups/
!accounts/README.txt

# 运行时日志和用量统计
usage/*.jsonl
usage/*.json
usage/*.sqlite3
usage/*.sqlite3-journal
usage/*.sqlite3-wal
usage/*.sqlite3-shm
!usage/README.txt
usage/*.bak*

# 运行时模型目录落盘缓存（上游 /v3/config 成功响应的副本，重启后作兜底；删除安全）
catalog/*.json
catalog/*.tmp
!catalog/README.txt

# 运行时日志文件
logs/

# 测试套件输出（tests/run_all.py --logs 落盘的每个套件的完整输出）
suite-logs/

# 便携版内置运行时（仓库只保存纯源码，绿色包通过 Release 发布）
# 锚定到仓库根目录：不加前导 / 会连 iOS 的 Resources/python（包内资源目录）一起忽略。
/python/
*.zip

# 发布打包产物（release 工作流与 wrt/ 脚本的输出，只该出现在 Release 资产里）
dist/
.sdk-cache/
wrt/ipk/
wrt/apk/
# build-apk.sh 把 wb_*.py 暂存进包目录再拷给 SDK，这是构建中间产物
wrt/openwrt/workbuddy2api/files/usr/lib/

# 项目隔离测试环境
.venv/
.playwright-browsers/
.test-artifacts/
.pytest_cache/

# Python 编译缓存
__pycache__/
*.py[cod]
*$py.class

# 系统与编辑器文件
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.codebuddy/
.workbuddy/

# Local Docker Compose override
docker-compose.override.yml

# ---- 移动端（iOS / Android）----
# 两端的网关核心都是从仓库根目录复制进去的构建产物，源头只有一份，绝不入库。
mobile/android/app/src/main/assets/core/
# iOS 包内资源：app/ 是核心代码，python/ 是 CPython 标准库，均由 sync-core.sh 生成。
mobile/ios/WorkBuddyHub/Resources/app/*
!mobile/ios/WorkBuddyHub/Resources/app/.gitkeep
mobile/ios/WorkBuddyHub/Resources/python/*
!mobile/ios/WorkBuddyHub/Resources/python/.gitkeep
# Android 构建输出与本地 SDK 配置
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/local.properties
# iOS 构建输出、生成的工程与下载的 Python 运行时（均由 CI 重建）
mobile/ios/build/
mobile/ios/Vendor/
mobile/ios/*.xcodeproj/
mobile/ios/*.ipa
