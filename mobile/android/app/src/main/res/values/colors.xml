<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 配色 = 面板新界面（dashboard.html 里 html[data-ui="next"] 那套 token）：
         colorPrimary = accent、header_bg = panel、page_bg = bg、
         text_primary = fg、text_secondary = dim。
         手机上打开面板看到的正是这一套（旧的 :root 暖色版只在旧界面下生效），
         而外壳和面板拼在同一个屏幕上——状态栏压着面板顶栏、覆盖层直接盖在面板区域上。
         两边各写一套颜色，看上去就是两个 App 拼起来的。
         tests/_test_android_ui_tokens.py 会拿这里的值跟外部面板 token 契约对账。 -->
    <color name="colorPrimary">#4F46E5</color>
    <color name="header_bg">#FFFFFF</color>
    <color name="page_bg">#F4F6F9</color>
    <color name="text_primary">#101828</color>
    <color name="text_secondary">#667085</color>
    <color name="dot_idle">#98A2B3</color>
    <color name="dot_running">#12B76A</color>

    <!-- 按钮 = 面板的 button / button.sec 两个变体：
         主按钮实心 accent + 白字，次按钮 panel 底 + 1dp line 描边 + fg 字。 -->
    <color name="button_primary">#4F46E5</color>
    <color name="button_primary_disabled">#AAA7F0</color>
    <color name="button_on_primary">#FFFFFF</color>
    <color name="button_on_primary_disabled">#B3FFFFFF</color>
    <color name="button_secondary_bg">#FFFFFF</color>
    <color name="button_secondary_border">#E3E7EE</color>
    <color name="button_label_disabled">#BABEC8</color>
    <color name="button_ripple">#33FFFFFF</color>
</resources>
