<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <!-- 这里的 @color 是浅色档的初值。系统切深浅时 Activity 不再重建（清单放行了
         uiMode），所以这一层的颜色由 MainActivity.applyShellColors() 重新刷一遍，
         两个 id 就是给那次刷新用的。 -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/header_bg"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_idle" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/status_stopped"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_more"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/page_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/overlayText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/overlay_idle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- 两个按钮同尺寸、同圆角、同字号，只差「实心 / 描边」：
                 主按钮 = 这一步最该做的动作，次按钮 = 另一条也能走通的路。
                 外观全部来自 Hub.Button.*，布局里不许再单独写 background/textSize。 -->
            <Button
                android:id="@+id/overlayAction"
                style="@style/Hub.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/overlay_action" />

            <!-- 首次安装最省事的入口：不用去 GitHub 找 Download ZIP，点一下
                 直接下最新 main 并导入。项目已经导入后由代码隐藏。 -->
            <Button
                android:id="@+id/overlayAutoImport"
                style="@style/Hub.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/button_gap"
                android:text="@string/overlay_auto_import" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
